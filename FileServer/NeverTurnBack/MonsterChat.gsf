/////////////////////////////////////////////////////////////////////////////////////
/////////////										Function List									/////////////
/////////////////////////////////////////////////////////////////////////////////////

void MonsterChat(int, int, int, int, int, string); // KID, ?????, ??? ??ID, ????, ??, ?????

/////////////////////////////////////////////////////////////////////////////////////


/////////////////////////////////////////////////////////////////////////////////////
/////////////										Definition										/////////////
/////////////////////////////////////////////////////////////////////////////////////  
//
//		?? ID
//	
//		????			=0	
//		???? ???	=1	
//		???? ??		=2	
//		???? ???	=3	
//		???? ??		=4	
//		???? ???	=5	
//		???				=6
//		??					=7
//						
/////////////////////////////////////////////////////////////////////////////////////
//
//		?? ID	
//							
//		??					=255	
//		??					=0		
//		???				=7		
//					
/////////////////////////////////////////////////////////////////////////////////////
//
//		Skill ID
//		
//		?? Skill			=0xFFFF	
//						
/////////////////////////////////////////////////////////////////////////////////////
//
//		$KILLERNAME$		會取代為殺者(怪物)的名稱. 行動ID要在7次(死亡)的情況才可以
//		$ATTNAME$			會取代為攻擊者(怪物)的名稱. 行動ID是 1, 3, 5 (被攻擊時)時才會取代
//		$DEFNAME$			會取代為被攻擊者(怪物)的名稱. 行動ID是0, 2, 4 (攻擊時)時才可以取代(被攻擊者很多的情況, 由random)
//
//		KID, 怪物行動, 怪物技能ID, 與聊天種類一樣的情況, 機率會加起來計算.
//
/////////////////////////////////////////////////////////////////////////////////////
//
//		ex 
//
//		MonsterChat(4001, 2, 0xFFFF, 0, 20, "使用技能時聊天訊息1");
//		MonsterChat(4001, 2, 0xFFFF, 0, 20, "使用技能時聊天訊息2");
//		(任意選擇1~100的數字, 上面的訊息是1~20, 下面的訊息是21~40. 除外的數字不會顯示.) 
//		不是復活的情況對話的前面會出現怪物名稱.
//
/////////////////////////////////////////////////////////////////////////////////////


