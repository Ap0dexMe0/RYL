<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="launcher2.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:System="clr-namespace:System;assembly=mscorlib" Height="610" Width="1044" ResizeMode="NoResize" WindowStyle="None" Title="login" xmlns:launcher2="clr-namespace:launcher2;assembly=launcher" Closing="Window_Closing" Loaded="Window_Loaded">
  <Grid Background="#FF000000" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
    <Grid Margin="10,5,10,0" VerticalAlignment="Top">
      <TextBlock Name="title" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Welcome" VerticalAlignment="Top" FontSize="14" Foreground="#FFFFFFFF" />
      <Button Name="minBtn" Content="_" HorizontalAlignment="Right" Margin="0,0,25,0" VerticalAlignment="Top" Width="20" Height="20" BorderThickness="2" Style="{DynamicResource MainButtonStyle}" IsCancel="True" Click="minBtn_Click" />
      <Button Name="exitBtn" Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" FontWeight="Bold" BorderThickness="2" Style="{DynamicResource MainButtonStyle}" Click="exitBtn_Click" />
    </Grid>
    <Grid Name="RootGrid">
      <DockPanel Name="frame" Margin="10,30,10,0" Height="480" VerticalAlignment="Top" />
      <Grid VerticalAlignment="Bottom" Margin="10,0,10,34">
        <Rectangle Stroke="#FF727071" RadiusX="7" RadiusY="7" StrokeThickness="3" Fill="{DynamicResource MainRectangleBrush}" />
        <Grid Margin="12,0,275,34" VerticalAlignment="Bottom">
          <TextBlock Height="18" TextWrapping="Wrap" Text="PROGRESS:" VerticalAlignment="Bottom" TextAlignment="Left" FontSize="16" Foreground="#FFFFFFFF" />
          <TextBlock Name="progressPercent" Height="18" Margin="88,0,607,0" TextWrapping="Wrap" Text="0%" VerticalAlignment="Bottom" FontSize="16" Foreground="#FFFFFFFF" FontWeight="Bold" />
        </Grid>
        <Grid Margin="10,0,275,11" VerticalAlignment="Bottom">
          <ProgressBar Name="progressBar" Height="18" VerticalAlignment="Bottom" Value="-1" Style="{DynamicResource MainProgressBarStyle}" ValueChanged="progressBar_ValueChanged" />
          <TextBlock Name="progressLog" Height="18" TextWrapping="Wrap" Text=" Checking server" VerticalAlignment="Bottom" TextAlignment="Left" FontSize="11">
            <TextBlock.Foreground>
              <LinearGradientBrush StartPoint="0,9" EndPoint="0,9" MappingMode="Absolute">
                <GradientStop Color="White" Offset="0.5" />
                <GradientStop Color="Black" Offset="0.5" />
              </LinearGradientBrush>
            </TextBlock.Foreground>
          </TextBlock>
        </Grid>
        <Button Name="startBtn" Content="Game Start" HorizontalAlignment="Right" Width="265" FontSize="24" BorderBrush="#FF7D4701" BorderThickness="4" Style="{DynamicResource StartButtonStyle}" FontWeight="Bold" Height="62" Click="startBtn_Click" />
      </Grid>
      <Grid Margin="10,0,10,5" VerticalAlignment="Bottom">
        <Button Name="settingBtn" Content="Setting" HorizontalAlignment="Left" Width="75" BorderThickness="2" Style="{DynamicResource MainButtonStyle}" Height="25" Click="settingBtn_Click" />
        <Button Name="joinBtn" Content="Join" HorizontalAlignment="Left" Margin="80,0,0,0" Width="75" BorderThickness="2" Style="{DynamicResource MainButtonStyle}" Height="25" Click="joinBtn_Click" />
      </Grid>
    </Grid>
  </Grid>
</Window>