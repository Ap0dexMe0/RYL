<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="launcher2.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:launcher2="clr-namespace:launcher2;assembly=launcher" KeyDown="Grid_KeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="GameTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#FF0D0D0D" />
        <Setter Property="Foreground" Value="#FFDDBB66" />
        <Setter Property="TextBoxBase.CaretBrush" Value="#FFDDBB66" />
        <Setter Property="BorderBrush" Value="#FF6A4A00" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="TextBoxBase.SelectionBrush" Value="#88DDAA33" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Grid>
                <Border CornerRadius="2" BorderThickness="1" Margin="-1">
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#55DDAA33" Offset="0" />
                      <GradientStop Color="#22DDAA33" Offset="1" />
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                </Border>
                <Border Name="MainBorder" Background="#FF0D0D0D" CornerRadius="2" BorderThickness="1">
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#FF8A6010" Offset="0" />
                      <GradientStop Color="#FF3A2000" Offset="1" />
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                  <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsFocused" Value="True">
                  <Setter TargetName="MainBorder" Property="Border.BorderBrush">
                    <Setter.Value>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFDDAA33" Offset="0" />
                        <GradientStop Color="#FF885500" Offset="1" />
                      </LinearGradientBrush>
                    </Setter.Value>
                  </Setter>
                  <Setter TargetName="MainBorder" Property="Border.Background" Value="#FF111100" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GamePasswordBoxStyle" TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="#FF0D0D0D" />
        <Setter Property="Foreground" Value="#FFDDBB66" />
        <Setter Property="PasswordBox.CaretBrush" Value="#FFDDBB66" />
        <Setter Property="BorderBrush" Value="#FF6A4A00" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="PasswordBox.SelectionBrush" Value="#88DDAA33" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type PasswordBox}">
              <Grid>
                <Border CornerRadius="2" BorderThickness="1" Margin="-1">
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#55DDAA33" Offset="0" />
                      <GradientStop Color="#22DDAA33" Offset="1" />
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                </Border>
                <Border Name="MainBorder" Background="#FF0D0D0D" CornerRadius="2" BorderThickness="1">
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#FF8A6010" Offset="0" />
                      <GradientStop Color="#FF3A2000" Offset="1" />
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                  <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsFocused" Value="True">
                  <Setter TargetName="MainBorder" Property="Border.BorderBrush">
                    <Setter.Value>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFDDAA33" Offset="0" />
                        <GradientStop Color="#FF885500" Offset="1" />
                      </LinearGradientBrush>
                    </Setter.Value>
                  </Setter>
                  <Setter TargetName="MainBorder" Property="Border.Background" Value="#FF111100" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GameLoginButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Border Name="GlowBorder" CornerRadius="3" Margin="-2" Opacity="0">
                  <Border.Background>
                    <SolidColorBrush Color="#33DDAA33" />
                  </Border.Background>
                </Border>
                <Border Name="ButtonBg" CornerRadius="3" BorderThickness="1">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                      <GradientStop Color="#FFA46903" Offset="0" />
                      <GradientStop Color="#FF5C3300" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                      <GradientStop Color="#FFDDAA44" Offset="0" />
                      <GradientStop Color="#FF7C4701" Offset="1" />
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="GlowBorder" Property="UIElement.Opacity" Value="1" />
                  <Setter TargetName="ButtonBg" Property="Border.Background">
                    <Setter.Value>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FFCC8804" Offset="0" />
                        <GradientStop Color="#FF7A4400" Offset="1" />
                      </LinearGradientBrush>
                    </Setter.Value>
                  </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonBg" Property="Border.Background">
                    <Setter.Value>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FF3A2000" Offset="0" />
                        <GradientStop Color="#FF7A4400" Offset="1" />
                      </LinearGradientBrush>
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GameCancelButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFAAAAAA" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Border Name="ButtonBg" CornerRadius="3" BorderThickness="1">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                      <GradientStop Color="#FF222222" Offset="0" />
                      <GradientStop Color="#FF111111" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                      <GradientStop Color="#FF555555" Offset="0" />
                      <GradientStop Color="#FF333333" Offset="1" />
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ButtonBg" Property="Border.Background">
                    <Setter.Value>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FF333333" Offset="0" />
                        <GradientStop Color="#FF222222" Offset="1" />
                      </LinearGradientBrush>
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Rectangle>
      <Shape.Fill>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop Color="#FF0A0800" Offset="0" />
          <GradientStop Color="#FF050400" Offset="1" />
        </LinearGradientBrush>
      </Shape.Fill>
    </Rectangle>
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="12" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" HorizontalAlignment="Center">
        <Grid Margin="0,0,0,6">
          <Rectangle Height="1">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00DDAA33" Offset="0" />
                <GradientStop Color="#88DDAA33" Offset="0.5" />
                <GradientStop Color="#00DDAA33" Offset="1" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
        </Grid>
        <TextBlock Text="L O G I N" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FF887744" HorizontalAlignment="Center" Margin="0,0,0,4" />
        <Grid Margin="0,4,0,0">
          <Rectangle Height="1">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00DDAA33" Offset="0" />
                <GradientStop Color="#44DDAA33" Offset="0.5" />
                <GradientStop Color="#00DDAA33" Offset="1" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
        </Grid>
      </StackPanel>
      <Border Grid.Row="2" CornerRadius="4" BorderThickness="1" Padding="36,28">
        <Border.Background>
          <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FF151208" Offset="0" />
            <GradientStop Color="#FF0D0B06" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FF6A4A10" Offset="0" />
            <GradientStop Color="#FF2A1A00" Offset="1" />
          </LinearGradientBrush>
        </Border.BorderBrush>
        <UIElement.Effect>
          <DropShadowEffect Color="#FFDDAA33" BlurRadius="12" ShadowDepth="0" Opacity="0.15" />
        </UIElement.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="14" />
            <RowDefinition Height="44" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FF887744" VerticalAlignment="Center" HorizontalAlignment="Left" />
          <TextBox Name="Ctr_UserID" Grid.Row="0" Grid.Column="1" Height="36" Style="{StaticResource GameTextBoxStyle}" VerticalContentAlignment="Center" AllowDrop="False" KeyDown="Input_KeyDown" TextChanged="Ctr_UserID_TextChanged" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="PASSWORD" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FF887744" VerticalAlignment="Center" HorizontalAlignment="Left" />
          <PasswordBox Name="Ctr_Password" Grid.Row="2" Grid.Column="1" Height="36" Style="{StaticResource GamePasswordBoxStyle}" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" PasswordChanged="Ctr_Password_PasswordChanged" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="loginBtn" Content="SIGN IN" Width="110" Height="34" Style="{StaticResource GameLoginButtonStyle}" Margin="0,0,10,0" Click="loginBtn_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>