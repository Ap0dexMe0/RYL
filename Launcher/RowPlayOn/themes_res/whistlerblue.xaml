            <Path Name="CheckedVisual" Height="6" Width="6" HorizontalAlignment="Right" VerticalAlignment="Center" StrokeLineJoin="Miter" Opacity="0" Data="M6,0 L6,6 L0,6" Fill="{StaticResource treeviewArrowChecked}" />
