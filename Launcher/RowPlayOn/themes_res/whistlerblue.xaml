              <Rectangle Name="BackgroundGradientSelectedDisabled" Stroke="#7F8E8F8F" RadiusX="2" RadiusY="2" Opacity="0" Fill="{StaticResource grayGradient}" />
              <Rectangle Name="BackgroundGradientSelected" RadiusX="2" RadiusY="2" Opacity="0" Fill="{StaticResource BtnOverFill}" Stroke="{StaticResource selectedStroke}" />
