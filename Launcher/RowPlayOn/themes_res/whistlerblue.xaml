                    <ToolBarPanel Name="PART_ToolBarPanel" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Margin="0,1,2,2" IsItemsHost="True" />
                  </Grid>
                </DockPanel>
              </Grid>
