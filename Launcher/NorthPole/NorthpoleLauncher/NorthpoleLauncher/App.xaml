<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="NorthpoleLauncher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:northpolelauncher="clr-namespace:NorthpoleLauncher;assembly=NorthpoleLauncher" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="Accent" Color="#4FB3FF" />
      <SolidColorBrush x:Key="AccentDeep" Color="#1F6DD1" />
      <SolidColorBrush x:Key="AccentIce" Color="#BFE6FF" />
      <SolidColorBrush x:Key="Gold" Color="#E6B450" />
      <SolidColorBrush x:Key="GoldDim" Color="#B8892E" />
      <SolidColorBrush x:Key="TextPrimary" Color="#E6E6E6" />
      <SolidColorBrush x:Key="TextMuted" Color="#9A9DA6" />
      <SolidColorBrush x:Key="TextTitle" Color="#E7CD93" />
      <SolidColorBrush x:Key="PanelBg" Color="#E60E0F13" />
      <SolidColorBrush x:Key="CardBg" Color="#FF15161C" />
      <SolidColorBrush x:Key="CardBorder" Color="#FF23252E" />
      <SolidColorBrush x:Key="ButtonBg" Color="#FF1A1B21" />
      <SolidColorBrush x:Key="ButtonBgHover" Color="#FF262830" />
      <SolidColorBrush x:Key="ButtonBorder" Color="#FF3A3C46" />
      <SolidColorBrush x:Key="Green" Color="#3DDC84" />
      <SolidColorBrush x:Key="Amber" Color="#F5A623" />
      <SolidColorBrush x:Key="Red" Color="#E5484D" />
      <FontFamily x:Key="SerifFont">Palatino Linotype, Georgia, Times New Roman</FontFamily>
      <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>
      <Style x:Key="DarkButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="46" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Control.Padding}" Background="{StaticResource ButtonBg}" BorderBrush="{StaticResource ButtonBorder}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource ButtonBgHover}" />
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="#5A5D6A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Border.Background" Value="#111218" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GoldButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#F4FAFF" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Width" Value="184" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" CornerRadius="4" BorderThickness="1" BorderBrush="#E6B450">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#6CC8FF" Offset="0" />
                    <GradientStop Color="#2F8BE6" Offset="0.55" />
                    <GradientStop Color="#1B57B0" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <UIElement.Effect>
                  <DropShadowEffect Color="#4FB3FF" BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
                </UIElement.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="#FFE39A" />
                  <Setter TargetName="bd" Property="UIElement.Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NavTab" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,30,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="10" />
                </Grid.RowDefinitions>
                <TextBlock Name="txt" Text="{TemplateBinding ContentControl.Content}" Foreground="{TemplateBinding Control.Foreground}" FontSize="{TemplateBinding Control.FontSize}" FontFamily="{TemplateBinding Control.FontFamily}" Typography.Capitals="AllSmallCaps" FontWeight="SemiBold" />
                <Rectangle Name="ul" Grid.Row="1" Height="2" VerticalAlignment="Bottom" Visibility="Hidden" Fill="{StaticResource Accent}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="txt" Property="TextBlock.Foreground" Value="{StaticResource TextPrimary}" />
                  <Setter TargetName="ul" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="txt" Property="TextBlock.Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="#00FFFFFF" CornerRadius="3">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Border.Background" Value="#33FFFFFF" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GoldProgress" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ProgressBar}">
              <Grid>
                <Border Name="PART_Track" Background="#2A2B33" CornerRadius="3" />
                <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#1F6DD1" Offset="0" />
                      <GradientStop Color="#6CC8FF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SlimScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="#1A1B21" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Border Background="#1A1B21" CornerRadius="5" Width="10">
                <Track Name="PART_Track" IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb>
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Border Background="#4A4C58" CornerRadius="5" Margin="2" />
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ServerCombo" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <ToggleButton Name="tb" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Border BorderThickness="1" CornerRadius="4" Background="{StaticResource ButtonBg}" BorderBrush="{StaticResource ButtonBorder}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="24" />
                          </Grid.ColumnDefinitions>
                          <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#9A9DA6" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </ToggleButton>
                <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" />
                <Popup Name="PART_Popup" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Top" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                  <Border Background="#16171D" BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" BorderBrush="{StaticResource ButtonBorder}">
                    <ScrollViewer MaxHeight="200">
                      <StackPanel IsItemsHost="True" />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
              <Setter Property="Padding" Value="10,6" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="bd" Background="#00FFFFFF" Padding="{TemplateBinding Control.Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                        <Setter TargetName="bd" Property="Border.Background" Value="#2A2C36" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>