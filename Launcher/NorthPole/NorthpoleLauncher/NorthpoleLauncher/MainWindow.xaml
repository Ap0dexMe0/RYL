<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NorthpoleLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Login" Width="1000" Height="640" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="#00FFFFFF" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True" xmlns:northpolelauncher="clr-namespace:NorthpoleLauncher;assembly=NorthpoleLauncher" Loaded="Window_Loaded" Closing="Window_Closing">
  <Border CornerRadius="8" Background="#0B0C10" BorderBrush="#1E3D66" BorderThickness="1">
    <UIElement.Clip>
      <RectangleGeometry Rect="0,0,1000,640" RadiusX="8" RadiusY="8" />
    </UIElement.Clip>
    <Grid>
      <Image Source="Assets/background.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Canvas Name="SnowCanvas" IsHitTestVisible="False" ClipToBounds="True" />
      <Rectangle>
        <Shape.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#B3000000" Offset="0" />
            <GradientStop Color="#33000000" Offset="0.6" />
            <GradientStop Color="#00000000" Offset="1" />
          </LinearGradientBrush>
        </Shape.Fill>
      </Rectangle>
      <Rectangle Height="185" VerticalAlignment="Top">
        <Shape.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6000000" Offset="0" />
            <GradientStop Color="#99000000" Offset="0.55" />
            <GradientStop Color="#00000000" Offset="1" />
          </LinearGradientBrush>
        </Shape.Fill>
      </Rectangle>
      <Rectangle Height="170" VerticalAlignment="Bottom">
        <Shape.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#B3000000" Offset="0.5" />
            <GradientStop Color="#E6000000" Offset="1" />
          </LinearGradientBrush>
        </Shape.Fill>
      </Rectangle>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="150" />
          <RowDefinition Height="*" />
          <RowDefinition Height="44" />
          <RowDefinition Height="72" />
          <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid Row="0" Background="#00FFFFFF" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Image Source="Assets/logo.png" Height="124" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
            <Button Style="{StaticResource CaptionButton}" Content="–" ToolTip="Minimize" Click="Minimize_Click" />
            <Button Style="{StaticResource CaptionButton}" Content="✕" ToolTip="Close" Click="Close_Click" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="36,0,0,4">
            <RadioButton Name="TabHome" Style="{StaticResource NavTab}" Content="HOME PAGE" IsChecked="True" Click="TabHome_Click" />
            <RadioButton Style="{StaticResource NavTab}" Content="CREATE ACCOUNT" Tag="CreateAccount" Click="TabLink_Click" />
            <RadioButton Style="{StaticResource NavTab}" Content="ITEM MALL" Tag="ItemMall" Click="TabLink_Click" />
            <RadioButton Style="{StaticResource NavTab}" Content="COMMUNITY" Tag="Community" Click="TabLink_Click" />
            <RadioButton Style="{StaticResource NavTab}" Content="SUPPORT" Tag="Support" Click="TabLink_Click" />
            <RadioButton Style="{StaticResource NavTab}" Content="DISCORD" Tag="Discord" Click="TabLink_Click" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Width="492" HorizontalAlignment="Left" Margin="26,6,0,6" CornerRadius="6" Background="{StaticResource PanelBg}" BorderBrush="#1E2028" BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,12,6,12">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBar}" />
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <ItemsControl Name="NewsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="5" Padding="14,12" Margin="0,0,6,10">
                    <StackPanel>
                      <Border HorizontalAlignment="Left" BorderBrush="#2F8BE6" BorderThickness="1" CornerRadius="3" Background="#1A0E2A4A" Padding="8,2" Margin="0,0,0,8">
                        <TextBlock Foreground="{StaticResource Accent}" FontSize="10.5" FontFamily="{StaticResource MonoFont}" Text="{Binding Tag}" />
                      </Border>
                      <TextBlock Foreground="{StaticResource TextTitle}" FontFamily="{StaticResource SerifFont}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding Title}" />
                      <TextBlock Foreground="#C9CACF" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,8" Text="{Binding Summary}" />
                      <TextBlock FontSize="11" FontFamily="{StaticResource SerifFont}" Cursor="Hand" Tag="{Binding Url}" MouseLeftButtonUp="ReadMore_Click">
                        <Run Text="READ MORE" Foreground="{StaticResource Accent}" />
                        <Run Text=" →" Foreground="{StaticResource Accent}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <Grid Row="2" Margin="26,0,26,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Amber}" Margin="0,0,10,0" />
            <TextBlock Text="Client Status:" Foreground="{StaticResource TextPrimary}" FontSize="13" />
            <TextBlock Name="StatusText" Text="Starting..." Foreground="#FFFFFFFF" FontSize="13" FontWeight="Bold" Margin="6,0,0,0" />
          </StackPanel>
          <ProgressBar Name="Progress" Grid.Column="1" Style="{StaticResource GoldProgress}" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Margin="16,0,16,0" />
          <TextBlock Name="ProgressText" Grid.Column="2" Text="" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
        </Grid>
        <Grid Row="3" Margin="26,0,26,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Name="VersionText" Text="v----" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
            <ComboBox Name="ServerCombo" Style="{StaticResource ServerCombo}" Margin="16,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Name="SoundButton" Style="{StaticResource DarkButton}" Margin="0,0,10,0" Click="Sound_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Name="SoundIcon" Text="🔊" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Sound" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="FileCheckButton" Style="{StaticResource DarkButton}" Margin="0,0,10,0" Click="FileCheck_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗎" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="File Check" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="SetupButton" Style="{StaticResource DarkButton}" Margin="0,0,10,0" Click="Setup_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Setup" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="StartButton" Style="{StaticResource GoldButton}" Content="START GAME" IsEnabled="False" Click="Start_Click" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="4" Background="#F20A0B0F" BorderBrush="#1E2028" BorderThickness="0,1,0,0">
          <Grid Margin="26,0,26,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Name="ServerDot" Width="7" Height="7" Fill="{StaticResource TextMuted}" Margin="0,0,10,0" />
              <TextBlock Name="ServerTzLabel" Text="Server (UTC+1)" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
              <TextBlock Name="ServerTimeText" Text="--:--:--" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" />
              <TextBlock Text="Your Time" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="22,0,0,0" />
              <TextBlock Name="LocalTimeText" Text="--:--:--" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" />
              <TextBlock Name="OnlineText" Text="" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="22,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="⚔" Foreground="{StaticResource Red}" FontSize="12" Margin="0,0,8,0" />
              <TextBlock Text="Next War" Foreground="{StaticResource Red}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
              <TextBlock Name="NextWarText" Text="--:--:--" Foreground="{StaticResource Red}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>